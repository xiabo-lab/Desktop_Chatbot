# Credentials. The first three lines are the whole of the specification's
# "never commit API credentials" requirement, and `aipi5/core/config.py`'s
# KEY_FILES must never grow a name that is not listed here.
openai API.txt
openai_api_key.txt
.openai_key
.env

# Models. Fetched on the device with scripts/, several hundred megabytes, and
# deploys go over `git archive | ssh` — the same reason AIA keeps its own out.
models/
vendor/

# Runtime state
conversation_history.db
conversation_history.db-wal
conversation_history.db-shm
.bench/
*.log

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# The video call's credentials. These live under ~/.config/aipi5 by default and
# should never appear here at all — this is the backstop for a deployment that
# pointed them somewhere else, and tests/test_call.py asserts the tree is clean.
*.pem
call-devices.json

# The Google Photos slideshow's credentials, on exactly the same footing: the
# OAuth client and the refresh token both default to ~/.config/aipi5, and
# `_secret_path` resolves a relative setting there rather than against the
# project root precisely so neither can land in a checkout. This is the
# backstop; tests/test_photos.py asserts the tree is clean.
google-photos-client.json
google-photos-token.json
